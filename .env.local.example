# ==================================================
# PDFHome — Environment Variables
# ==================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ---- Google AdSense ----
# Your AdSense publisher client ID (starts with ca-pub-)
# Get this from: https://www.google.com/adsense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXXXX

# ---- Site URL ----
# Used for sitemap generation and canonical URLs
# Change to your actual domain when deploying
SITE_URL=https://pdfhome.com

# ---- Analytics ----
# No additional env vars needed — analytics uses the built-in API route
# The endpoint is hardcoded to /api/analytics
