.pnp
.pnp.js
.pnp.cjs
.pnp.loader.mjs
.pnpm-debug.log*
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
bun.lockb

# ==============================================================================
# Build & Output directories
# ==============================================================================
.next/
out/
build/
dist/
target/
*.tsbuildinfo
next-env.d.ts

# ==============================================================================
# Local Environment & Secrets (NEVER commit these)
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.pfx
*.p12

# ==============================================================================
# Debug logs & Diagnostic artifacts
# ==============================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# Test & Coverage reports
# ==============================================================================
coverage/
.nyc_output/
.playwright/
playwright-report/
test-results/
cypress/screenshots/
cypress/videos/

# ==============================================================================
# IDEs and Editor configurations
# ==============================================================================
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains (WebStorm, IntelliJ IDEA, etc.)
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Text editors (Vim, Emacs)
*~
*.swp
*.swo
.netrwhist

# ==============================================================================
# Operating System files
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ==============================================================================
# Custom / Tooling artifacts
# ==============================================================================
.vercel
.turbo/
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache/
.cache/
.gemini/
.antigravity/

# Temporary files & local test uploads
tmp/
temp/
*.tmp
*.temp
test.pdf

# ==============================================================================
# Markdown files (Ignore all except README)
# ==============================================================================
*.md
!README.md
!readme.md

